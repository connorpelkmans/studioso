<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for ios/App/App/App.entitlements -->
<plist version="1.0">
<dict>
  <!-- Push Notifications (native-bridge.js enablePush, APNs) -->
  <key>aps-environment</key>
  <string>development</string>
  <!-- Universal links -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:YOUR-DOMAIN.example</string>
  </array>
  <!-- Quick capture (UNTESTED template; see native/ and VOICE-CAPTURE-NATIVE.md) -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.studioso.app</string>
  </array>
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.studioso.app.shared</string>
  </array>
  <!-- In-app purchase needs the capability switched on in Xcode but no entitlement key -->
</dict>
</plist>
