<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys merged into ios/App/App/Info.plist by npm run ios:stage (scripts/plist-merge.js); keys already there are kept -->
<plist version="1.0">
<dict>
  <!-- Encryption export compliance -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <!-- App Transport Security -->

  <!-- Photos: "Attach a Screenshot" in Report a Bug, photo notes -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Studyboard uses your photos only when you choose one to attach to a task, note or flashcard, or to send with a bug report.</string>
  <!-- Camera: the same pickers offer "Take Photo" -->
  <key>NSCameraUsageDescription</key>
  <string>Studyboard uses the camera only when you choose to take a photo, to turn a picture of a page, a schedule or a board into tasks, notes or flashcards.</string>

  <!-- Push reminders are real in the wrapper -->
  <key>UIBackgroundModes</key>
  <array>
    <string>remote-notification</string>
  </array>

  <!-- The microphone, for Record a Lecture (Pro) -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Studyboard uses the microphone only while you record a lecture, so you can turn the class into notes.</string>
  <!-- Live captions while recording (the web view's speech recognition uses Apple's recognizer) -->
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Studyboard writes live captions while you record a lecture.</string>

  <!-- AlarmKit (iOS 26+): the end of a focus session rings as a real alarm, through silent mode, like the Clock app's timer -->
  <key>NSAlarmKitUsageDescription</key>
  <string>Studyboard rings an alarm when a focus session or break ends, even with your phone on silent.</string>

  <!-- Deliberately NOT present (the app does not use them) -->

  <!-- Custom URL scheme for deep links such as studyboard://open?task=ID -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.studioso.app</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>studyboard</string>
      </array>
    </dict>
  </array>

  <!-- Quick capture (UNTESTED) -->
  <key>SBKeychainAccessGroup</key>
  <string>$(AppIdentifierPrefix)com.studioso.app.shared</string>

  <key>LSApplicationCategoryType</key>
  <string>public.app-category.education</string>
  <key>UIRequiresFullScreen</key>
  <false/>

  <!-- The Focus timer in the Dynamic Island and on the Lock Screen -->
  <key>NSSupportsLiveActivities</key>
  <true/>
</dict>
</plist>
