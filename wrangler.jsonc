{
  "name": "studioso",
  "compatibility_date": "2026-10-06",
  "previews": {},
  "build": { "command": "node scripts/build-site.js" },
  "main": "cloudflare/site/worker.js",
  "vars": { "SUPABASE_URL": "https://pivcmrqcjseycjkbocmc.supabase.co", "SUPABASE_ANON_KEY": "sb_publishable_hoKTO5FRblXqHs6MvO686Q_81c5_gvd" },
  // Page text for Cards From a Link (cloudflare/site/page-text.js): at most 20 pages a minute for each visitor
  "ratelimits": [{"name": "PAGE_LIMIT", "namespace_id": "1001", "simple": {"limit": 20, "period": 60}}],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/functions/*", "/website/*", "!/website/assets/*", "/privacy", "/privacy.html", "/terms", "/terms.html", "/flashcards", "/flashcards/*", "/quizzes", "/quizzes/*", "/sitemap-public.xml", "/switch/*", "/api/*"]
  }
}
