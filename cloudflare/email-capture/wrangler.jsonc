// Email to Studyboard (Pro): a Cloudflare Email Worker (free plan). See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyboard-email-capture",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": false },
  // No public web address: it only receives email through Email Routing.
  "workers_dev": false,
  "vars": {
    // Your Supabase project address (the same one the app uses, SB_DEFAULT in index.html)
    "SUPABASE_URL": "https://pivcmrqcjseycjkbocmc.supabase.co"
  }
  // Secret (never here): npx wrangler secret put EMAIL_CAPTURE_SECRET   (the same value as the capture-email function's secret)
}
