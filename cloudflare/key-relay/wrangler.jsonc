// The Studyboard key relay
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyboard-key-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "HANDOFF", "class_name": "Handoff" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Handoff"] }],
  "ratelimits": [{ "name": "POST_LIMIT", "namespace_id": "4721", "simple": { "limit": 20, "period": 60 } }],
  "vars": {
    "APP_URL": ""
  }
}
