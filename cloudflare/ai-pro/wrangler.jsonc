// Studyboard AI (paid Pro): Claude Haiku 5.5 through Cloudflare AI Gateway, paid with Cloudflare's Unified Billing.
// Off until CF_ACCOUNT_ID and AI_GATEWAY_ID are set below and the CF_AIG_TOKEN secret is added.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyboard-pro-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Nothing students send is logged
  "observability": { "enabled": false },
  // Whisper (lecture transcription) and bge-m3 (search by meaning) on Workers AI
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "STUDENT", "class_name": "StudentMeter" }, { "name": "TOTALS", "class_name": "DayTotals" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StudentMeter", "DayTotals"] }],
  "vars": {
    "SUPABASE_URL": "https://pivcmrqcjseycjkbocmc.supabase.co",
    "SUPABASE_KEY": "sb_publishable_hoKTO5FRblXqHs6MvO686Q_81c5_gvd",
    // Your Cloudflare account id and the AI Gateway's name (Dashboard, AI, AI Gateway)
    "CF_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "",
    // Per paid Pro student, per calendar month (UTC), in US dollars. Past the soft limit everyday jobs think less;
    // at the hard limit AI stops until next month. The same limits apply to a student's own Claude key in Studyboard AI mode.
    "MONTHLY_SOFT_USD": "3",
    "MONTHLY_HARD_USD": "4",
    // One student in one day
    "DAILY_USD": "1",
    "PER_MINUTE": "20",
    "MAX_INFLIGHT": "4",
    // "1" turns Studyboard AI off without removing anything
    "PRO_AI_OFF": "",
    "WHISPER_OFF": "",
    // The owner's usage summary (GET /v1/owner/usage) needs the OWNER_TOKEN secret: at least 24 random characters
    // YouTube links go to Google's Gemini through the same gateway; "1" turns them off
    "YOUTUBE_OFF": "",
    // YouTube videos each paid Pro student can turn into notes and cards a month (at most 100; "0" turns them off)
    "YOUTUBE_MONTHLY": "20"
  }
}
