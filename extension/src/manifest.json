{
  "manifest_version": 3,
  "name": "Studyboard School Sync",
  "short_name": "Studyboard",
  "version": "1.0.11",
  "description": "Keeps Studyboard up to date with your Canvas, Brightspace or Blackboard: due dates, submissions, grades and feedback.",
  "homepage_url": "https://studyboardapp.com/website/",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Studyboard School Sync",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*"],
  "externally_connectable": { "matches": ["https://studyboardapp.com/*", "https://www.studyboardapp.com/*"] },
  "content_scripts": [
    { "matches": ["https://studyboardapp.com/*", "https://www.studyboardapp.com/*"], "js": ["relay.js"], "run_at": "document_start" }
  ],
  "minimum_chrome_version": "116"
}
