<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store build (parent app) -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>TEAM_ID.com.studyboardapp.studyboard</string>
  </array>
  <!-- Supabase, the AI provider the person chose, their school's sign-in page, fonts and links -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Sign in with Google or Apple returns to a one-time page on 127.0.0.1 (main.js auth:port) -->
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- "Choose Folder" for the Studyboard data folder -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Remember the chosen data folder between launches -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- The microphone, for Record a Lecture (Pro) -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Deliberately NOT present -->
</dict>
</plist>
