<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store build (parent app). App Sandbox is mandatory. Replace TEAM_ID (10 characters, from developer.apple.com > Membership)
       here and in package.json (build.mas.extendInfo.ElectronTeamID). The application-identifier / team-identifier entitlements are
       added from the provisioning profile when electron-builder signs. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>TEAM_ID.com.studioso.app</string>
  </array>
  <!-- Supabase, the AI provider the person chose, their school's sign-in page, fonts and links. Outgoing connections only. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- "Choose Folder" for the Studyboard data folder, and file pickers for attaching files and importing backups. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Remember the chosen data folder between launches (security-scoped bookmark, see main.js dir:choose). -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- Deliberately NOT present: network.server, files.downloads.read-write (exports go through the save dialog), camera, audio-input,
       personal-information.*, temporary-exception.* (Apple rejects most of them), disable-library-validation, JIT entitlements
       (Hardened Runtime does not apply to Mac App Store builds). -->
</dict>
</plist>
