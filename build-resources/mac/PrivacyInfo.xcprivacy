<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE (Electron: package.json build.mac.extraResources copies it to Contents/Resources/PrivacyInfo.xcprivacy). Keep it in step with the App Privacy answers in App Store Connect (APP-STORE-CHECKLIST.md section 6). Collected data: email, display name, user id, device id, user content, photos (attachments and bug screenshots), purchase history (Pro), study minutes shared with a group, diagnostics inside a bug report the person sends, and anonymous crash and error reports (CrashData and PerformanceData: NOT linked to identity, not used for tracking, purpose app functionality; they carry only a random per-install id, never the account id; see ERROR-REPORTING.md). All are for app functionality, linked to the account, and none is used for tracking. Required-reason API reasons are the ones a WKWebView/Chromium wrapper uses: re-check after adding a plugin (each plugin ships its own manifest and Xcode merges them). -->
<plist version="1.0">
<dict>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
