<?xml version="1.0" encoding="utf-8"?>
<!-- One task on the Today widget: a round checkbox (ticks it off) and the title (opens the task) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/sbw_row_check"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="5dp"
        android:src="@drawable/sbw_check_off" />
    <ImageView
        android:id="@+id/sbw_row_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/sbw_dot" />
    <TextView
        android:id="@+id/sbw_row_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/sbw_ink"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/sbw_row_meta"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:maxWidth="110dp"
        android:textColor="@color/sbw_muted"
        android:textSize="12sp" />
</LinearLayout>
