<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown widget (2x1 to 4x2): the next exam or big deadline, the days left, and readiness when known -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sbc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sbw_bg"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/sbc_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/sbw_setup"
        android:textColor="@color/sbw_muted"
        android:textSize="13sp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/sbc_body"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:gravity="center_horizontal"
            android:minWidth="36dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/sbc_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/sbw_accent"
                android:textSize="34sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/sbc_days_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sbw_muted"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/sbc_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textColor="@color/sbw_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/sbc_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/sbw_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/sbc_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/sbw_muted"
                android:textSize="12sp" />
            <ProgressBar
                android:id="@+id/sbc_ready"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressDrawable="@drawable/sbw_progress"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
