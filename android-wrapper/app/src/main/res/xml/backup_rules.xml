<?xml version="1.0" encoding="utf-8"?>
<!-- UNTESTED: Android 11 and lower full-backup rules (android:fullBackupContent). allowBackup="false" already turns backup off there; these rules
     match data_extraction_rules.xml in case that flag is ever flipped: nothing is backed up (WebView data under app_webview/ with the Supabase
     session, Canvas token and school cookies; the encrypted capture token; the pending capture queue; databases). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
