<?xml version="1.0" encoding="utf-8"?>
<!-- UNTESTED: Android 12+ backup and device-transfer rules. On Android 12+ these REPLACE android:allowBackup="false", so they must exclude
     everything themselves. Nothing of the app's own storage is backed up or moved to a new phone: the WebView data under app_webview/ (the
     Supabase session and the Canvas token in localStorage, school sign-in cookies), the encrypted capture token (sb_capture.xml, whose Keystore
     key cannot move anyway), the pending capture queue and any database. Everything is re-synced from the student's account after sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
