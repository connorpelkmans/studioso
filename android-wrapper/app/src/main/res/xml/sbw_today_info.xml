<?xml version="1.0" encoding="utf-8"?>
<!-- Today widget: 2x2 to 4x4 (Android 12+ uses the cell counts; older launchers the dp sizes, n x 70 - 30) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/sbw_today_desc"
    android:initialLayout="@layout/sbw_today"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="320dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:previewLayout="@layout/sbw_today"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
