<?xml version="1.0" encoding="utf-8"?>
<!-- UNTESTED: written without Android Studio -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push reminders (@capacitor/push-notifications + FCM) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Record a Lecture (Pro) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Block distracting apps (Android): Do Not Disturb during a Focus session; the student grants the access once in Settings -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- ...and it is put back after a phone restart in the middle of a session (focus/FocusGuard.kt) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- (1) On the existing <application ...> element add these attributes -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="studyboard" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- only the app's own address (/?deck=, /?group=, /?task=, as in apple-app-site-association): reset-password.html,
                     confirm-signup.html, magic links and /website/ pages must keep opening in the browser -->
                <data android:scheme="https" android:host="YOUR-DOMAIN.example" android:path="/" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".capture.ShareReceiverActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.QuickCaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_quick_capture"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- BEGIN sb-native: widgets, the Focus notification, Do Not Disturb, reminder buttons. scripts/android-build.js merges this
             block as one, before </application>. The manifest root needs xmlns:tools="http://schemas.android.com/tools". -->
        <!-- Home-screen widgets (widgets/HomeWidgets.kt). The providers must be exported for the launcher; ticks and redraws go
             through WidgetActionReceiver, which is not. -->
        <receiver
            android:name=".widgets.TodayWidgetProvider"
            android:exported="true"
            android:label="@string/sbw_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sbw_today_info" />
        </receiver>
        <receiver
            android:name=".widgets.CountdownWidgetProvider"
            android:exported="true"
            android:label="@string/sbw_countdown_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sbw_countdown_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetActionReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- The Focus timer's ongoing notification: Pause/Resume/Stop (focus/FocusNotification.kt) -->
        <receiver android:name=".focus.FocusActionReceiver" android:exported="false" />
        <!-- Do Not Disturb put back at the session's end, and after a restart (focus/FocusGuard.kt) -->
        <receiver android:name=".focus.FocusGuardReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Reminders with Mark Done and Snooze 1 Hour (notify/): Studyboard's messaging service replaces the push plugin's own -->
        <receiver android:name=".notify.ReminderActionReceiver" android:exported="false" />
        <service android:name=".notify.StudyboardMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service android:name="com.capacitorjs.plugins.pushnotifications.MessagingService" tools:node="remove" />
        <!-- END sb-native -->

    </application>
</manifest>
