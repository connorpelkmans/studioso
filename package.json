{
  "name": "studyboard",
  "productName": "Studyboard",
  "version": "1.13.0",
  "description": "Studyboard: a student planner for courses, deadlines, study sessions and flashcards",
  "author": {
    "name": "Studyboard"
  },
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node prepare.js && electron .",
    "prep": "node prepare.js",
    "dist": "node prepare.js && electron-builder --win nsis --x64",
    "dist:win-signed": "node prepare.js && electron-builder --win nsis --x64 --config build-resources/electron-builder.win-signed.js",
    "dist:mac": "node prepare.js && electron-builder --mac dmg --arm64 -c.mac.identity=-",
    "dist:linux": "node prepare.js && electron-builder --linux AppImage",
    "dist:mac-intel": "node prepare.js && electron-builder --mac dmg --x64 -c.mac.identity=- '-c.mac.artifactName=Studyboard-${version}-mac-intel.${ext}'",
    "dist:mac-signed": "node prepare.js && electron-builder --mac dmg --universal -c.dmg.sign=true '-c.mac.artifactName=Studyboard-${version}-mac-universal.${ext}'",
    "dist:mas": "node prepare.js && electron-builder --mac mas --universal",
    "dist:mas-dev": "node prepare.js && electron-builder --mac mas-dev --universal",
    "check:store": "node notarize.js --check mas",
    "check:mas-dev": "node notarize.js --check mas-dev",
    "check:signed": "node notarize.js --check signed",
    "test": "node scripts/run-tests.js",
    "test:e2e": "node scripts/run-tests.js --e2e --no-unit --no-slow",
    "test:slow": "node scripts/run-tests.js --e2e --no-unit --only-slow",
    "test:all": "node scripts/run-tests.js --e2e",
    "lint": "eslint . && node scripts/lint-inline.js"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "com.studioso.app",
    "productName": "Studyboard",
    "copyright": "Copyright © 2026 Studyboard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lms.js",
      "widget/**/*",
      "app/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Studyboard",
      "legalTrademarks": "Studyboard"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Studyboard",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Studyboard-Setup-${version}.${ext}",
      "uninstallDisplayName": "Studyboard"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "artifactName": "Studyboard-${version}-mac.${ext}",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Studyboard keeps your data, daily backups and files in a Studyboard folder in Documents.",
        "NSDownloadsFolderUsageDescription": "Studyboard saves files you export to Downloads.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.education",
        "ElectronTeamID": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist",
      "extraResources": [
        {
          "from": "build-resources/mac/PrivacyInfo.xcprivacy",
          "to": "PrivacyInfo.xcprivacy"
        }
      ]
    },
    "mas": {
      "type": "distribution",
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "entitlements": "build-resources/entitlements.mas.plist",
      "entitlementsInherit": "build-resources/entitlements.mas.inherit.plist",
      "provisioningProfile": "build-resources/Studyboard_MAS.provisionprofile",
      "artifactName": "Studyboard-${version}-mas.${ext}",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.education",
        "ElectronTeamID": "REPLACE_WITH_APPLE_TEAM_ID"
      }
    },
    "masDev": {
      "type": "development",
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "entitlements": "build-resources/entitlements.mas-dev.plist",
      "entitlementsInherit": "build-resources/entitlements.mas.inherit.plist",
      "provisioningProfile": "build-resources/Studyboard_MASDev.provisionprofile",
      "artifactName": "Studyboard-${version}-mas-dev.${ext}",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.education",
        "ElectronTeamID": "REPLACE_WITH_APPLE_TEAM_ID"
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "Studyboard-${version}.${ext}"
    },
    "publish": null,
    "dmg": {
      "title": "Studyboard ${version}",
      "iconSize": 112,
      "window": {
        "width": 560,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterSign": "notarize.js",
    "afterAllArtifactBuild": "notarize.js",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "protocols": [
      {
        "name": "Studyboard",
        "schemes": [
          "studyboard"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=22.12"
  }
}
